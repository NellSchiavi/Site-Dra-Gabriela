APP_NAME="Dra. Gabriela Ferri Paes"
# Produção (Render): APP_ENV=production e APP_DEBUG=false — NUNCA true
# (expõe stack trace, SQL, caminhos e variáveis de ambiente).
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local (Docker): serviço "pgsql" do compose.yaml.
# Produção (Render): usar DB_URL com a "Internal Database URL" do Postgres.
DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=gabriela
DB_USERNAME=sail
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produção (HTTPS): SESSION_SECURE_COOKIE=true
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# Demo sem envio de e-mail: tudo vai apenas para o log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@example.invalid"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Identificação discreta "Ambiente de demonstração" no rodapé/painel.
DEMO_MODE=true

# Acesso ao painel /admin — definido SOMENTE aqui (local) ou nas variáveis
# de ambiente do Render. Senha com no mínimo 12 caracteres.
ADMIN_NAME="Dra. Gabriela Ferri Paes"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Docker local
APP_PORT=8080
FORWARD_DB_PORT=5434
WWWUSER=1000
WWWGROUP=1000
